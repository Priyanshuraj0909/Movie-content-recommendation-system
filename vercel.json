{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/web"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "vercel_entry.py",
      "buildCommand": "bash scripts/setup_demo.sh --skip-evaluation",
      "functions": {
        "vercel_entry.py": {
          "includeFiles": "{artifacts/content_recommender.joblib,artifacts/collaborative_recommender.joblib,artifacts/semantic/**,data/processed/movies_with_tags.csv,data/processed/links.csv,data/processed/movie_plots.csv,src/recommender/**,backend/migrations/**}",
          "excludeFiles": "{tests/**,browser_tests/**,.venv/**,data/raw/**,artifacts/*.db,artifacts/*.log,mlruns/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
